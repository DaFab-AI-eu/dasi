{
    "name": "dasi",
    "dockerComposeFile": "docker-compose.yml",
    "service": "dasi-dev",
    "workspaceFolder": "/workspace",
    "postStartCommand": "bash /usr/local/bin/rucio-setup.sh",
    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
                "python.formatting.provider": "black",
                "python.linting.ruffEnabled": true,
                "python.linting.enabled": true,
                "editor.formatOnSave": true,
                "[python]": {
                    "editor.codeActionsOnSave": {
                        "source.organizeImports": "explicit"
                    }
                },
                "python.testing.pytestEnabled": true,
                "python.testing.pytestArgs": [
                    "pydasi/tests"
                ],
                "cmake.configureOnOpen": false,
                "cmake.generator": "Ninja",
                "cmake.buildDirectory": "/tmp/build/dasi-bundle",
                "cmake.exportCompileCommandsFile": true,
                "cmake.installPrefix": "/usr/local",
                "cmake.cmakePath": "/usr/bin/cmake",
                "cmake.configureSettings": {
                    "CMAKE_C_COMPILER": "/opt/rh/gcc-toolset-14/root/usr/bin/gcc",
                    "CMAKE_CXX_COMPILER": "/opt/rh/gcc-toolset-14/root/usr/bin/g++"
                },
                "cmake.sourceDirectory": "${workspaceFolder}",
                "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
                "clangd.arguments": [
                    "--compile-commands-dir=/tmp/build/dasi-bundle",
                    "--log=error",
                    "--background-index",
                    "--clang-tidy",
                    "--fallback-style=llvm",
                    "--pretty",
                    "--function-arg-placeholders=0",
                    "--completion-style=detailed",
                    "--completion-parse=always",
                    "--header-insertion=never",
                    "--header-insertion-decorators",
                    "--all-scopes-completion",
                    "--pch-storage=memory",
                    "-j=24"
                ]
            },
            "extensions": [
                "llvm-vs-code-extensions.vscode-clangd",
                "ms-vscode.cpptools",
                "ms-vscode.cpp-devtools",
                "ms-vscode.cmake-tools",
                "ms-python.python",
                "ms-python.isort",
                "ms-python.black-formatter",
                "ms-python.vscode-pylance",
                "ms-python.pytest-adapter",
                "ms-python.debugpy"
            ]
        }
    }
}
